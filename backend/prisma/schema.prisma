// LabFlow schema - production datasource is PostgreSQL.
// Local development uses prisma/schema.dev.prisma (sqlite), generated by
// scripts/use-sqlite.cjs. Keep the two in sync by only ever editing this file.
//
// Deliberate constraints for dual-database compatibility:
//   - no Prisma `enum` (unsupported on SQLite) -> constrained Strings + Zod
//   - no `Json` columns (unsupported on SQLite) -> serialised TEXT with helpers
//   - no native type attributes (@db.*)
//   - no case-insensitive query mode (unsupported on SQLite)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               String // ADMIN | LAB_MANAGER | LAB_STAFF
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions            Session[]
  uploadedImports     MonthlyImport[]     @relation("ImportUploader")
  mediaPreparations   MediaPreparation[]  @relation("MediaCreator")
  mediaUpdates        MediaPreparation[]  @relation("MediaUpdater")
  autoclaveLogs       AutoclaveLog[]      @relation("AutoclaveResponsible")
  cleaningCompleted   AutoclaveCleaning[] @relation("CleaningResponsible")
  auditEntries        AuditLog[]          @relation("AuditActor")

  @@index([role])
}

model Session {
  id                String   @id @default(cuid())
  userId            String
  tokenHash         String   @unique
  csrfHash          String
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  ip                String?
  userAgent         String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MonthlyImport {
  id              String    @id @default(cuid())
  filename        String
  fileHash        String
  reportingMonth  Int
  reportingYear   Int
  status          String // PROCESSING | COMPLETED | FAILED | REPLACED
  totalRows       Int       @default(0)
  acceptedRows    Int       @default(0)
  rejectedRows    Int       @default(0)
  duplicateRows   Int       @default(0)
  sourceFormat    String // XLSX | CSV
  columnMapping   String? // JSON snapshot of the mapping used
  uploadedById    String
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  uploadedBy User              @relation("ImportUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  samples    Sample[]
  rowErrors  ImportRowError[]

  @@index([fileHash])
  @@index([reportingYear, reportingMonth])
  @@index([status])
  @@index([uploadedById])
}

model ImportRowError {
  id        String   @id @default(cuid())
  importId  String
  rowNumber Int
  code      String
  message   String
  rawData   String? // JSON of the offending row (already length-capped)
  createdAt DateTime @default(now())

  import MonthlyImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
}

model Sample {
  id             String   @id @default(cuid())
  dedupeKey      String   @unique
  sampleIdentifier String?
  sampleName     String
  registrationDate DateTime
  sampleCategory String // WATER | NON_WATER | UNKNOWN
  categorySource String   @default("IMPORT") // IMPORT | MAPPING | MANUAL
  importId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  import             MonthlyImport       @relation(fields: [importId], references: [id], onDelete: Cascade)
  mediaPreparations  MediaPreparation[]
  autoclaveLogs      AutoclaveLog[]

  @@index([registrationDate])
  @@index([sampleCategory])
  @@index([importId])
  @@index([sampleName])
}

model MediaPreparation {
  id              String   @id @default(cuid())
  sampleId        String?
  preparationDate DateTime
  mediaType       String
  batchNo         String?
  quantity        Float?
  unit            String?
  notes           String?
  status          String   @default("DRAFT") // DRAFT | RECORDED
  createdById     String
  updatedById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sample    Sample? @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  createdBy User    @relation("MediaCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User?   @relation("MediaUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  autoclaveLogs AutoclaveLog[]

  @@unique([sampleId, preparationDate, mediaType])
  @@index([preparationDate])
  @@index([status])
}

model AutoclaveLog {
  id                          String   @id @default(cuid())
  logDate                     DateTime
  cycleLoadName               String
  sampleId                    String?
  mediaPreparationId          String?
  autoclaveStartTime          String // HH:mm
  sterilizationStartTime      String // HH:mm
  temperature                 Float
  temperatureUnit             String   @default("C")
  pressure                    Float
  pressureUnit                String   @default("LBS")
  sterilizationDurationMinutes Int
  endTime                     String // HH:mm
  endTimeOverridden           Boolean  @default(false)
  verificationStatus          String   @default("DRAFT") // DRAFT | PENDING_VERIFICATION | VERIFIED
  responsibleUserId           String?
  remarks                     String?
  createdById                 String
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  sample      Sample?           @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  preparation MediaPreparation? @relation(fields: [mediaPreparationId], references: [id], onDelete: Restrict)
  responsible User?             @relation("AutoclaveResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@unique([logDate, cycleLoadName])
  @@index([logDate])
  @@index([verificationStatus])
}

model AutoclaveCleaning {
  id                String    @id @default(cuid())
  scheduledDate     DateTime  @unique
  completedAt       DateTime?
  status            String    @default("PENDING") // PENDING | COMPLETED
  responsibleUserId String?
  remarks           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  responsible User? @relation("CleaningResponsible", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([status])
}

model AutoclaveSettings {
  id                         String   @id @default("singleton")
  labName                    String   @default("PETLAD MAHAL AROGYA MANDAL PHARMACY")
  labAddress                 String   @default("Piplata")
  documentFormatNo           String   @default("")
  documentSopReference       String   @default("")
  equipmentNumber            String   @default("")
  autoclaveStartTime         String   @default("11:00")
  sterilizationStartTime     String   @default("11:10")
  temperature                Float    @default(121)
  temperatureUnit            String   @default("C")
  pressure                   Float    @default(15)
  pressureUnit               String   @default("LBS")
  durationMinutes            Int      @default(15)
  cleaningAnchorDate         DateTime @default(now())
  cleaningFirstIntervalDays  Int      @default(6)
  cleaningIntervalDays       Int      @default(7)
  groupingRule               String   @default("PER_DAY")
  updatedAt                  DateTime @updatedAt

  @@map("AutoclaveSettings")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String
  entityType String
  entityId   String?
  metadata   String? // JSON, secrets stripped before write
  ip         String?
  requestId  String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}
