# ---------------------------------------------------------------------------
# LabFlow environment template.
#   Copy to backend/.env   (PowerShell: Copy-Item .env.example backend/.env)
#   NEVER commit backend/.env.
# The backend fails fast in production if required secrets are missing.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# Local development default is SQLite (file based), set up by `npm run db:dev`.
# Production MUST use PostgreSQL (schema.prisma provider is postgresql).
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER=sqlite

# Host/port the API listens on
PORT=4000
API_HOST=0.0.0.0

# Comma separated list of exact frontend origins allowed by CORS (no wildcards)
CORS_ORIGINS=http://localhost:5173

# Public base URL of the frontend (used in docs/links)
APP_BASE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Secrets - generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required in production. The server refuses to start if these are missing
# or left blank / at an example value while NODE_ENV=production.
# ---------------------------------------------------------------------------
SESSION_SECRET=
# Pepper appended to passwords before bcrypt hashing (changing it invalidates
# every existing password hash - treat rotation as a forced reset for all users)
PASSWORD_PEPPER=

# Session lifetime in minutes (sliding window)
SESSION_TTL_MINUTES=480
# Absolute session lifetime in minutes (hard cap, cannot slide past this)
SESSION_ABSOLUTE_TTL_MINUTES=1440

# ---------------------------------------------------------------------------
# Login protection
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_MAX=600

# Upload limits (bytes). 10 MiB default.
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=20000

# ---------------------------------------------------------------------------
# Demo data
# Creates demo users + synthetic samples for local evaluation.
# FORCED OFF when NODE_ENV=production, regardless of this flag.
# ---------------------------------------------------------------------------
ALLOW_DEMO_SEED=false
DEMO_ADMIN_EMAIL=admin@labflow.local
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_STAFF_PASSWORD=

# Behind a reverse proxy (nginx, ALB) set to 1 so secure cookies / client IPs work
TRUST_PROXY=0
